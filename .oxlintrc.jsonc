{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "import",
    "jsx-a11y",
    "oxc",
    "promise",
    "react",
    // "react-perf",
    "typescript",
    "unicorn",
    "vitest"
    // "nextjs",
    // "node"
  ],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error",
    "typeCheck": true,
    "denyWarnings": false // don't fail build on warnings
  },
  "env": {
    "browser": true,
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "warn",
    "restriction": "warn",
    "style": "off",
    "nursery": "off"
  },
  "rules": {
    // eslint
    "eslint/no-console": "off",
    "eslint/no-plusplus": "off",
    "eslint/no-new": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-undefined": "off",
    "eslint/no-warning-comments": "off",
    "eslint/max-lines-per-function": [
      "warn",
      {
        "skipComments": true,
        "skipBlankLines": true,
        "max": 150 // includes React components
      }
    ],
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    // react
    "react/react-in-jsx-scope": "off",
    "react/jsx-filename-extension": "off",
    "react/forbid-component-props": "off",
    "react/jsx-no-literals": "off",
    "react/rules-of-hooks": "error",
    // React Compiler - correctness
    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    // React Compiler - suspicious
    "react/capitalized-calls": "error",
    "react/memo-dependencies": "error",
    "react/hooks": "error",
    "react/exhaustive-effect-dependencies": "error",
    // React Compiler - performance
    "react/no-deriving-state-in-effects": "warn",
    // React Compiler - restrictions
    "react/invariant": "warn",
    "react/rule-suppression": "warn",
    "react/syntax": "warn",
    "react/todo": "warn",
    "react/unsupported-syntax": "warn",
    // typescript
    "typescript/consistent-type-imports": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/promise-function-async": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/no-deprecated": "warn",
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/switch-exhaustiveness-check": [
      "warn",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    // oxc
    "oxc/no-optional-chaining": "off",
    "oxc/no-async-await": "off",
    "oxc/no-rest-spread-properties": "off",
    // import
    "import/no-default-export": "off",
    "import/no-relative-parent-imports": "off",
    "import/unambiguous": "off",
    "import/max-dependencies": "off",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-duplicates": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level-if-only-type-imports"],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          // don't allow default React import
          {
            "name": "react",
            "importNames": ["default"],
            "message": "Use named imports instead."
          }
        ]
      }
    ],
    // needed for side-effect imports: global CSS, test setup, module augmentation.
    "import/no-unassigned-import": "off",
    // unicorn
    "unicorn/prefer-query-selector": "off"
  },
  "ignorePatterns": ["__mocks__/**", "coverage/**", "statistics/**", "dist/**", "**/*.gen.ts"],
  "overrides": [
    // React components and CSS in JS
    {
      "files": ["src/**/*.tsx", "src/**/*.styles.ts"],
      "rules": {
        "typescript/explicit-function-return-type": "off",
        "typescript/explicit-module-boundary-types": "off"
      }
    },
    // TanStack Router routes
    {
      "files": ["src/routes/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off",
        "react/no-multi-comp": "off",
        "eslint/no-use-before-define": "off"
      }
    },
    // tests
    {
      "files": ["**/*.spec.ts", "**/*.spec.tsx", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "eslint/max-lines-per-function": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/consistent-function-scoping": "off", // allow setup helpers inside describe blocks
        "vitest/consistent-test-it": ["error", { "fn": "it" }],
        "vitest/require-top-level-describe": "error",
        "vitest/require-test-timeout": "off"
      }
    }
  ]
}
