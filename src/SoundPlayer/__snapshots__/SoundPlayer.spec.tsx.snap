// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SoundPlayer > should match snapshots 1`] = `
<audio
  aria-label="Meow sound"
  preload="auto"
>
  <source
    data-testid="audio-file"
    src="/src/assets/soundFile.wav"
    type="audio/wav"
  />
  <track
    data-testid="subtitles-file"
    default=""
    kind="captions"
    src="/src/assets/soundFile.vtt"
  />
</audio>
`;
