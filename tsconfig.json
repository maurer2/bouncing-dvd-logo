{
  "include": [
    "./src/**/*",
    "vite.config.ts",
    "jest.config.ts",
    ".eslint.config.mjs"
  ],
  "exclude": [],
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "vite/client",
      "vite-plugin-svgr/client",
      "vitest/globals",
      "@vitest/browser/providers/playwright",
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "jsx": "react",
    "sourceMap": true,
    "outDir": "./dist",
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "erasableSyntaxOnly": true
  }
}
